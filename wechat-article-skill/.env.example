# WeChat 新闻分析 LLM 配置
# 设置 USE_LLM=true 启用 LLM 分析，否则使用规则分析

USE_LLM=true

# LLM 服务配置
# 支持: openai, deepseek, anthropic 或任何 OpenAI 兼容 API
LLM_PROVIDER=openai

# API 密钥（请替换为你自己的密钥）
LLM_API_KEY=your-api-key-here

# 模型名称
# OpenAI: gpt-4o-mini, gpt-4o
# DeepSeek: deepseek-chat
# Anthropic: claude-3-5-haiku-20241022
LLM_MODEL=gpt-4o-mini

# API 基础地址（OpenAI 兼容格式）
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 其他 OpenAI 兼容服务: 填入对应的 base_url
LLM_BASE_URL=https://api.openai.com/v1

# 微信文章导出器 Auth Key（4天过期，过期后需重新登录获取）
# 获取方式：启动 exporter 后访问 http://localhost:3200/api/public/v1/authkey
AUTH_KEY=your-auth-key-here

# 行业配置（修改这些变量即可适配不同行业）
# INDUSTRY_NAME: 行业名称，用于报告标题和文件名
INDUSTRY_NAME=算力，数据中心，AI
# INDUSTRY_KEYWORDS: 行业关键词，用于文章筛选（逗号分隔）
INDUSTRY_KEYWORDS=算力,数据中心,AI,人工智能,GPU,芯片,智算,液冷,服务器,云计算,大模型
# INDUSTRY_CATEGORIES: 报告分类体系（逗号分隔，格式: emoji 名称:描述）
# 示例 - 医疗健康: 💰 融资与投资:融资、投资等,🏥 医疗政策:政策法规等,💊 新药研发:新药审批、临床试验等,⚠️ 风险:安全事件等,📊 其他:其他
# 示例 - 新能源: 💰 融资与投资:融资、投资等,☀️ 光伏:光伏技术、项目等,🔋 储能:储能技术、项目等,⚠️ 风险:安全事件等,📊 其他:其他
INDUSTRY_CATEGORIES=💰 融资与投资:融资、投资、收购、上市、发债等,🏢 数据中心建设:数据中心新建、扩建、选址、项目获批等,🔧 技术动态:技术发布、产品发布、模型发布、技术突破等,⚠️ 风险:安全事件、监管风险、纠纷诉讼、预警等,📊 其他:不符合以上任何类别的新闻
